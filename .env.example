# Copy to .env (or set as GitHub Actions secrets/variables). Never commit real values.

ANTHROPIC_API_KEY=sk-ant-...
SHEET_ID=your-google-sheet-id

BUSINESS_NAME=Acme Golf Simulators
BUSINESS_DOMAIN=example.com
SIGNER_NAME=Alex
# Subject keyword shared by form notification emails and their reply threads
SUBJECT_KEYWORD=Acme Golf Simulators
# Ignore mail older than this (Gmail search date)
START_DATE=2026/01/01

# Address(es) the website form sends notifications from
FORM_SENDER=forms@example.com
FORM_SENDER_ALT=inquiry@example.com
# Comma-separated team addresses whose sent replies are learned from
TEAM_SENDERS=inquiry@example.com,sales@example.com
FROM_EMAIL=inquiry@example.com
